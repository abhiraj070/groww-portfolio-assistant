# Generate your own local key (at least 32 characters). Blank fails closed.
SERVICE_API_KEY=
# Groww credentials are required for live reads, not health checks. Never commit your .env.
GROWW_AUTH_METHOD=api_key
GROWW_API_KEY=
GROWW_API_SECRET=
# With TOTP, GROWW_API_KEY will contain the Groww-issued TOTP token.
GROWW_TOTP_SECRET=
GROWW_REQUEST_TIMEOUT_SECONDS=10

# Valuation uses one explicit exchange; verify your holdings are listed there.
VALUATION_EXCHANGE=NSE
# Optional operator-verified JSON classification file; omit to leave sectors unknown.
# SECTOR_METADATA_FILE=C:/private-data/sectors.json
# Local private execution ledger; one account per file. Default: data/investments.sqlite3.
# LEDGER_PATH=C:/private-data/investments.sqlite3
API_REQUESTS_PER_MINUTE=300
